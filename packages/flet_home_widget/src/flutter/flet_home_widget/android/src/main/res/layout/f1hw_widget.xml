<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/f1hw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/f1hw_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/f1hw_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/f1hw_label"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/f1hw_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/f1hw_live_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="● LIVE"
            android:textColor="#E10600"
            android:textSize="11sp"
            android:textStyle="bold|italic"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/f1hw_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#D9FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/f1hw_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="До старта"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp" />

    <Chronometer
        android:id="@+id/f1hw_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold|italic" />

    <TextView
        android:id="@+id/f1hw_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="3"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/f1hw_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#99FFFFFF"
        android:textSize="10sp" />
</LinearLayout>
