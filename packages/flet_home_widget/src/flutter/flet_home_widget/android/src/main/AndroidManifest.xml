<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- будильники напоминаний ставятся заново после перезагрузки телефона -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application>
        <!-- Виджет F1 Hub на главный экран: данные пишет приложение, отсчёт ведёт Chronometer -->
        <receiver
            android:name="com.f1hub.flet_home_widget.F1WidgetProvider"
            android:exported="false"
            android:label="@string/f1hw_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/f1hw_widget_info" />
        </receiver>
        <!-- Напоминания при закрытом приложении: системный будильник -> уведомление (F1Reminders) -->
        <receiver
            android:name="com.f1hub.flet_home_widget.F1Reminders"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
